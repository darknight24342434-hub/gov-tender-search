# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/TEST_REPORT.html

# Secrets & local config
.env
.env.*
!.env.example
*.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local backups (never commit these)
*.bak
*.bak_*
*.orig

# Runtime data. data/ holds the SQLite database, run logs, and Playwright browser
# profile directories (data/.pw_*) that contain live session cookies. None of it
# belongs in version control.
data/
output/
reports/
*.db
*.db-wal
*.db-shm

# Playwright
.playwright-cli/
test-results/
playwright-report/

# Describes your own machines (paths, SSH targets, key locations). Never commit it.
workers.json
