# ===== 密碼閘（外網靠這個密碼進來）=====
# 必填：設好密碼，登入頁輸入這組就能進。空白 = 任何人都進不來。
APP_PASSWORD=請改成你的密碼
# Cookie 簽章金鑰，請改成一長串隨機字元（例如 `python -c "import secrets;print(secrets.token_hex(32))"`）
SECRET_KEY=請改成隨機字串
# 登入有效天數（秒）。預設 7 天。
SESSION_MAX_AGE=604800
# 部署到 https（Cloudflare Tunnel）後設 true，本機 http 測試設 false
COOKIE_SECURE=false

# ===== 資料庫 =====
DB_PATH=data/tenders.db

# ===== Codex CLI（ChatGPT 訂閱綁定，不需 API key）=====
# codex 執行檔名稱或絕對路徑
CODEX_BIN=codex
# 模型 ID（依你模型圓桌會議的慣例，預設 gpt-5.5）
CODEX_MODEL=gpt-5.5
# 額外旗標（避開 service_tier bug / agentic 漂移）
CODEX_EXTRA_ARGS=--ignore-user-config --skip-git-repo-check
# 單次呼叫逾時（秒）
CODEX_TIMEOUT=180
# 設 true 可完全停用 AI（爬蟲/搜尋照常運作，只是不產生摘要與標籤）
CODEX_DISABLED=false

# ===== 爬蟲 =====
PCC_API_BASE=https://pcc-api.openfun.app
PCC_WEB_BASE=https://pcc.g0v.ronny.tw
CRAWL_DELAY=0.8
